<Window x:Class="JambOfficeApp.Views.AddCandidateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:JambOfficeApp.ViewModels"
        xmlns:local="clr-namespace:JambOfficeApp.Views"
        mc:Ignorable="d"
        Title="Add Candidate" Height="560" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{materialDesign:MaterialDesignFont}">
    
    <Window.DataContext>
        <vm:AddCandidateViewModel></vm:AddCandidateViewModel>
    </Window.DataContext>
    
    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Text="NEW CANDIDATE" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}"
                   Margin="0,0,0,20"></TextBlock>
        
        <TextBox materialDesign:HintAssist.Hint="Reg Number" Text="{Binding RegNumber, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,0,0,12"></TextBox>
        
        <TextBox materialDesign:HintAssist.Hint="Full Name" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"></TextBox>
        
        <DatePicker materialDesign:HintAssist.Hint="Date Of Birth" SelectedDate="{Binding DateOfBirth}"
                    Margin="0,0,0,12"></DatePicker>
        
        <TextBox materialDesign:HintAssist.Hint="Gender" Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"></TextBox>
        
        <TextBox materialDesign:HintAssist.Hint="Phone Number" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,0,0,12"></TextBox>
        
        <TextBox materialDesign:HintAssist.Hint="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,0,0,12"></TextBox>
        
        <TextBox materialDesign:HintAssist.Hint="Institution Applied" Text="{Binding InstitutionApplied, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"></TextBox>
        
        <TextBox materialDesign:HintAssist.Hint="Department Applied" Text="{Binding DepartmentApplied, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"></TextBox>
        
        <TextBox materialDesign:HintAssist.Hint="JAMB Score" Text="{Binding JambScore, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"></TextBox>
        
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"></TextBlock>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 8, 0, 0">
            <Button Content="CANCEL" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="36"
                    Margin="0,0,8,0"></Button>
            <Button Content="Save" Command="{Binding SaveCommand}"
                    Height="36"></Button>
        </StackPanel>
    </StackPanel>
</Window>
